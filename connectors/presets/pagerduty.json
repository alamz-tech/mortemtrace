{
  "name": "PagerDuty",
  "source": "pagerduty",
  "kind": "alert",
  "is_change_source": false,
  "verification": {
    "strategy": "hmac",
    "header": "X-PagerDuty-Signature",
    "algorithm": "sha256",
    "encoding": "hex",
    "prefix": "v1="
  },
  "_setup": [
    "Service -> Integrations -> Generic Webhooks (v3) -> Add",
    "URL: <ingest-url>/webhook/<connector_id>",
    "PagerDuty shows a signing secret once - register it as secret_ref"
  ]
}
